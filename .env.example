# Public origin of the deployed site, no trailing slash (e.g. https://yosuayuwono.com).
# Drives canonical URLs, sitemap, robots, Open Graph and JSON-LD, plus tRPC links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL for your Cloudflare R2 CDN (custom domain or r2.dev URL).
# next.config.ts derives images.remotePatterns from it. Leave unset to serve
# media from public/ instead.
NEXT_PUBLIC_R2_CDN_URL=https://cdn.your-domain.com

# Used only by `pnpm assets:sync` (rclone). Credentials live in rclone's own
# config, not here — see README → R2 CDN.
R2_BUCKET=yosu-portfolio
R2_RCLONE_REMOTE=r2

# OpenRouter — powers the "ask about me" chat. Server-only; never prefix with NEXT_PUBLIC_.
# Pick a model at https://openrouter.ai/models (filter by price for free ones).
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_MODEL=qwen/your-model-id

# The chat's unanswered questions and bug reports live in Supabase Postgres. Create the tables with
# supabase/chat-unanswered.sql and supabase/chat-reports.sql, then the restricted login with
# supabase/chat-app-role.sql. Use the "Transaction pooler" string from Supabase's Connect panel with
# the user changed to chat_app.<project-ref>. Never use the default postgres owner login here, and
# never give this variable a NEXT_PUBLIC_ prefix. Unset = the chat works, it just saves nothing.
DATABASE_URL=postgresql://chat_app.<project-ref>:<password>@<pooler-host>:6543/postgres

# Supabase API (works storage; RLS for public reads; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Chat assistant: private facts the bot may share when asked (phone, birth date, relationships, rates).
# Kept in env, not in code, because this repo is public. One line per topic, tagged: contact, origin, faith, health, abroad, romance, partner, temper, orientation, salary, pricing, address.
CHAT_BIRTH_DATE=YYYY-MM-DD
CHAT_PRIVATE_FACTS="[contact] ...
[romance] ...
[salary] ...
[pricing] ..."

# Chat assistant: emails a visitor message to you when they want to hire, collaborate or complain.
# Resend (resend.com). Without a verified domain, INQUIRY_TO_EMAIL must be your own Resend account email.
RESEND_API_KEY=re_your_key
INQUIRY_TO_EMAIL=hello@yosuayuwono.com
# Needs a domain verified in Resend; until then it falls back to Resend's test sender.
INQUIRY_FROM_EMAIL="Portfolio Proposals <proposal@yourdomain.com>"
