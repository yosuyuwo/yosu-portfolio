# Public origin of the deployed site, no trailing slash (e.g. https://yosuayuwono.com).
# Drives canonical URLs, sitemap, robots, Open Graph and JSON-LD, plus tRPC links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL for your Cloudflare R2 CDN (custom domain or r2.dev URL).
# next.config.ts derives images.remotePatterns from it. Leave unset to serve
# media from public/ instead.
NEXT_PUBLIC_R2_CDN_URL=https://cdn.your-domain.com

# Used only by `pnpm assets:sync` (rclone). Credentials live in rclone's own
# config, not here — see README → R2 CDN.
R2_BUCKET=yosu-portfolio
R2_RCLONE_REMOTE=r2

# Supabase — works storage (RLS for public reads; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
