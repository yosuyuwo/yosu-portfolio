# App URL (used by tRPC server-side links when needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL for your Cloudflare R2 CDN (custom domain or r2.dev URL).
# Hostname must match the images.remotePatterns entry in next.config.ts.
NEXT_PUBLIC_R2_CDN_URL=https://cdn.your-domain.com

# Supabase — works storage (RLS for public reads; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
